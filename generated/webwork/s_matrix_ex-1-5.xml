    <statement><p>Determine <m>x</m> and <m>y</m> such that</p>
<p><me>\left[\begin{array}{ccc}
-2\amp  -2\amp  0 \cr
-4\amp  4\amp  0 
\end{array}\right]
 + \left[\begin{array}{ccc}
x-y      \amp  3 \amp  3 \\
1 \amp  x        \amp  1 
\end{array} \right]
= \left[\begin{array}{ccc}
0 \amp  1 \amp  3 \\
-3 \amp  2 x +y   \amp  1
\end{array}\right]</me></p>
<p><m>x =</m>    <fillin characters="10" name="AnSwEr0001"/></p>
<p><m>y =</m>   <fillin characters="10" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>3</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>1</m>
      </p>
    </answer>
