<exercises xml:id="s_ge_ex">
  <subexercises>
 
<exercisegroup>
  <title>Echelon forms</title>
  
  
  <introduction>
    <p>
      For the given matrix, determine (a) whether it is in row echelon form, and (b) whether it is in reduced row echelon form. Justify your answer. 
    </p>
  </introduction>
<exercise>
  <statement>
    <p>
      <m>\begin{bmatrix}
      1 \amp 2\amp 2\amp -3\\
      0\amp -3\amp 4\amp 0\\
      0\amp 0\amp 0\amp 1
      \end{bmatrix}</m>
    </p>
  </statement>
  <solution>
    <p>
      (a) The matrix is not in row echelon form, since the first nonzero entry in the second row is not a one. 
    </p>
    <p>
      (b) Since the matrix is not in row echelon form, it is definitely not in reduced row echelon form. 
    </p>
  </solution>
</exercise>
<exercise>
<statement>
<p>
<m>\begin{bmatrix}
1\amp 0\amp 0\amp 0\\
0\amp 1\amp 0\amp 0\\
0\amp 0\amp 0\amp 1
\end{bmatrix}</m>
</p>
</statement>
</exercise>
<exercise>
<statement>
<p>
<m>\begin{bmatrix}
1\amp 0\amp 0\amp 1\\
0\amp 1\amp 0\amp 0\\
0\amp 0\amp 0\amp 1
\end{bmatrix}</m>
</p>
</statement>

</exercise>

